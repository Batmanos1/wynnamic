{
	// Maximum distance in blocks at which chat bubbles are visible from other players
	"chatRange": 80.0,
	// Time in ticks (20 ticks = 1 second) that chat bubbles remain visible
	"chatTime": 260,
	// Maximum width in pixels before text wraps to a new line. Higher values make wider bubbles
	"maxChatWidth": 180,
	// The color of the text in the chat bubble (decimal RGB, e.g. 1315860 for dark grey, 16777215 for white)
	"chatColor": 1315860,
	// Extra vertical offset of bubbles in blocks. Positive values move up, negative values move down
	"chatHeight": 0.0,
	// Size multiplier for chat bubbles (1.0 = normal size, 2.0 = double size, 0.5 = half size)
	"chatScale": 1.0,
	// Transparency of the bubble background (0.0 = invisible, 1.0 = fully opaque)
	"backgroundOpacity": 0.699999988079071,
	// Red component of the bubble background tint (0.0 to 1.0)
	"backgroundRed": 1.0,
	// Green component of the bubble background tint (0.0 to 1.0)
	"backgroundGreen": 1.0,
	// Blue component of the bubble background tint (0.0 to 1.0)
	"backgroundBlue": 1.0,
	// Maximum number of words to check for player names in chat messages. 0 = unlimited. Lower values may improve performance
	"maxUUIDWordCheck": 0,
	// If enabled, shows chat bubbles above your own head when you chat
	"showOwnBubble": false,
	// Maximum number of stacked chat bubbles shown above a player at once
	"maxBubbles": 5,
	// Pixel gap between stacked bubbles
	"distanceBetweenBubbles": 2,
	// Extra padding (in pixels) between the text and the bubble border
	"balloonPadding": 0,
	// Log how each chat line was matched to a player (useful for diagnosing missing bubbles)
	"debugMode": false
}