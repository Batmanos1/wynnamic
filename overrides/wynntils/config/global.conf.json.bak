m_hex(\"#000000\"); from_hex(\"#70c1b3\"); \"FLAG\"; \"FLAG\"); \" \u0026l\"; format(raid_room_damage(1)); \"\u00267 \"; to_fancy_text(\"dmg\"); \"\u00267 (\"; format_duration(divide(raid_room_time(1); 1000)); \"\u00267)\"; \"\\n\"; to_background_text(\"Room 2\"; from_hex(\"#000000\"); from_hex(\"#f7b801\"); \"FLAG\"; \"FLAG\"); \" \u0026l\"; format(raid_room_damage(2)); \"\u00267 \"; to_fancy_text(\"dmg\"); \"\u00267 (\"; format_duration(divide(raid_room_time(2); 1000)); \"\u00267)\"; \"\\n\"; to_background_text(\"Room 3\"; from_hex(\"#000000\"); from_hex(\"#f18701\"); \"FLAG\"; \"FLAG\"); \" \u0026l\"; format(raid_room_damage(3)); \"\u00267 \"; to_fancy_text(\"dmg\"); \"\u00267 (\"; format_duration(divide(raid_room_time(3); 1000)); \"\u00267)\"; \"\\n\"; to_background_text(\"Boss\"; from_hex(\"#ffffff\"); from_hex(\"#ce4257\"); \"FLAG\"; \"FLAG\"); \" \u0026l\"; format(raid_room_damage(4)); \"\u00267 \"; to_fancy_text(\"dmg\"); \"\u00267 (\"; format_duration(divide(raid_room_time(4); 1000)); \"\u00267)\"; \"\\n\\n\"; to_background_text(\"Total\"; from_hex(\"#ffffff\"); from_hex(\"#679436\"); \"FLAG\"; \"FLAG\"); \" \u0026l\"; format(current_raid_damage); \"\u00267 \"; to_fancy_text(\"dmg\"); \"\u00267 (\"; format_duration(divide(current_raid_time; 1000)); \"\u00267)\"))}",
