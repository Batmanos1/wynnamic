  "infoBoxFeature.infoBoxOverlay7.content": "{concat_st(\n    styled_text(\n        to_background_text(\n            \"MOB\";\n            from_hex(\"#000000\");\n            from_hex(\"#ff9100\");\n            \"PILL\";\n            \"PILL\"\n        )\n    );\n\n    styled_text(\" \");\n\n    styled_text(mob_totem_owner(closest_mob_totem_number()));\n\n    styled_text(\" \");\n\n    with_color(\n        styled_text(\n            concat(\n                str(\n                    int(\n                        div(\n                            mob_totem_seconds_left(closest_mob_totem_number());\n                            60\n                        )\n                    )\n                );\n                \":\";\n                leading_zeros(\n                    int(\n                        mod(\n                            mob_totem_seconds_left(closest_mob_totem_number());\n                            60\n                        )\n                    );\n                    2\n                )\n            )\n        );\n\n        if_color(\n            gt(\n                mob_totem_seconds_left(closest_mob_totem_number());\n                150\n            );\n            from_hex(\"#55FF55\");\n\n            if_color(\n                gt(\n                    mob_totem_seconds_left(closest_mob_totem_number());\n                    60\n                );\n                from_hex(\"#FFFF55\");\n\n                if_color(\n                    gt(\n                        mob_totem_seconds_left(closest_mob_totem_number());\n                        15\n                    );\n                    from_hex(\"#FFAA00\");\n                    from_hex(\"#FF5555\")\n                )\n            )\n        )\n    );\n\n    styled_text(\" \");\n\n    with_color(\n        styled_text(\n            concat(\n                \"(\";\n                str(int(mob_totem_distance(closest_mob_totem_number())));\n                \"m)\"\n            )\n        );\n        from_hex(\"#AAAAAA\")\n    )\n)}",
