  "infoBoxFeature.infoBoxOverlay3.content": "{with_font(concat_st(\r\n  st(from_codepoint(add(7101;\r\n    if(lt(mod(ticks; 200); 50); 0; if(lt(mod(ticks; 200); 175);\r\n      clamp(div(sub(mod(ticks; 200); 50); 2.4); 1; 12);\r\n      sub(12; clamp(div(sub(mod(ticks; 200); 175); 2.4); 1; 12)))); \r\n    mul(13; clamp(int(div(adavg(15); 200000)); 0; 3)))));\r\n  repeat_st(st(from_codepoint(6950)); 2);\r\n  with_color(\r\n    st(from_codepoint(add(7091;\r\n      clamp(int(div(adavg(15); 150000)); 0; 9)\r\n    )));\r\n    wynncraft_shader(\"gradient\")\r\n  );\r\n  st(repeat(from_codepoint(6989); 5));\r\n  with_color(\r\n    st(from_codepoint(add(7051;\r\n      clamp(int(div(adavg(15); 20000)); 0; 39)\r\n    ))); \r\n    wynncraft_shader(if(gte(adavg(15); 820000); \"warp\"; \"none\"))\r\n  );\r\n  st(repeat(\"\\n\"; 2));\r\n  st(repeat(from_codepoint(7035); 4));\r\n  with_atlas_sprite_font(st(\"A\"); \"items\"; \"skins/resistance/syndra_banner\");\r\n  st(\"\\n\");\r\n  \r\n  st(repeat(from_codepoint(7037); 2));\r\n  with_atlas_sprite_font(st(\"A\"); \"items\"; \"skins/character/astal_gauntlet_text\");\r\n  st(\"\\n\");\r\n\r\n  repeat_st(concat_st(\r\n    st(from_codepoint(7040));\r\n    with_atlas_sprite_font(st(\"A\"); \"items\"; \"item/w-9167009971840039152\")\r\n  ); 2);\r\n    st(repeat(\"\\n\"; 3));\r\n  repeat_st(concat_st(\r\n    st(from_codepoint(7040));\r\n    with_atlas_sprite_font(st(\"A\"); \"items\"; \"item/w-9167009971840039152\")\r\n  ); 2);\r\n  st(\"\\n\");\r\n  st(from_codepoint(7044));\r\n  with_color(st(format(adavg(15))); if(gte(adavg(15); 820000); wynncraft_shader(\"rainbow\");\r\n    from_hex(switch(int(div(adavg(15); 100000)); \"#ebe9e9\";\r\n      2; \"#ebe967\"; 3; \"#64c3d3\"; 4; \"#c183c4\"; 5; \"#ea9898\"; 6; \"#ea9898\"; 7; \"#ea9898\"; 8; \"#ea9898\")))\r\n  );\r\n  st(\"\\n\");\r\n  st(from_codepoint(7041));\r\n  repeat_st(concat_st(\r\n    with_atlas_sprite_font(st(\"A\"); \"items\"; \"wynn/spell/meteor_0_a\");\r\n    st(from_codepoint(6995))\r\n    );\r\n    int(sub(\r\n      if(lt(adavg(15); 450000); div(adavg(15); 50000); 10); \r\n      div(adavg(15); 100000)\r\n    ))\r\n  );\r\n  repeat_st(concat_st(\r\n      with_atlas_sprite_font(st(\"A\"); \"items\"; \"wynn/spell/meteor_1_a\");\r\n      st(from_codepoint(6995))\r\n    );\r\n    int(mul(int(div(clamp(sub(adavg(15); 400000); 0; 1000000); 100000)); 2))\r\n  );\r\n  repeat_st(concat_st(\r\n      with_atlas_sprite_font(st(\"A\"); \"items\"; \"wynn/spell/meteor_0_a\");\r\n      st(from_codepoint(6995))\r\n    );\r\n    int(sub(\r\n      if(lt(adavg(15); 450000); div(adavg(15); 50000); 10); \r\n      div(adavg(15); 100000)\r\n    ))\r\n  )\r\n); \"tpack:default\")}",
