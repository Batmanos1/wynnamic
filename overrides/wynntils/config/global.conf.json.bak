  "infoBoxFeature.infoBoxOverlay1.content": "{concat(if_str(mte(adps; 1); if_str(mte(adps; 100000); if_str(mte(adps; 200000); if_str(mte(adps; 300000); if_str(mte(adps; 400000); if_str(mte(adps; 500000); if_str(mte(adps; 700000); if_str(mte(adps; 1000000); concat(\"\u00266⁤\u00260\u00266\u00260\u00266\u00260\u00266 \u0026#00F000FF\"; str(round(div(adps; 1000000); 1)); \"m \u0026#00F000FF\u0026lSTELLAR!\"); concat(\"\u00266⁤\u00260\u00266\u00260\u00266\u00260\u00266 \u0026b\"; str(round(div(adps; 1000); 1)); \"k \u00266☄\")); concat(\"\u00266⁤\u00260\u00266\u00260\u00266\u00260\u00266 \u00264\"; str(round(div(adps; 1000); 1)); \"k \u00266☄\")); concat(\"\u00266⁤\u00260\u00266\u00260\u00266\u00260\u00266 \u0026c\"; str(round(div(adps; 1000); 1)); \"k \u00266☄\")); concat(\"\u00266⁤\u00260\u00266\u00260\u00266\u00260\u00266 \u00266\"; str(round(div(adps; 1000); 1)); \"k \u00266☄\")); concat(\"\u00266⁤\u00260\u00266\u00260\u00266\u00260\u00266 \u0026e\"; str(round(div(adps; 1000); 1)); \"k \u00266☄\")); concat(\"\u00266⁤\u00260\u00266\u00260\u00266\u00260\u00266 \u0026a\"; str(round(div(adps; 1000); 1)); \"k \u00266☄\")); if_str(mte(adps; 1000); concat(\"\u00266⁤\u00260\u00266\u00260\u00266\u00260\u00266 \u00267\"; str(round(div(adps; 1000); 1)); \"k \u00266☄\"); concat(\"\u00266⁤\u00260\u00266\u00260\u00266\u00260\u00266 \u00267\"; str(int(adps)); \" \u00266☄\"))); \"\"); \"\\n\"; if_str(mte(adavg; 1); if_str(mte(tdmg; 10000000); concat(\"\u0026#066B6AFF⁤\u0026#066B6AFF\u0026#FFFFFFFF\u0026#066B6AFF\u0026#FFFFFFFF\u0026#066B6AFF\u0026#FFFFFFFF\u0026#066B6AFF \u0026#00F000FF\"; str(round(div(tdmg(10); 1000000); 1)); \"m \u0026e\u0026lULTRAKILL\u0026f\"); if_str(mte(tdmg(10); 1000000); concat(\"\u0026#066B6AFF⁤\u0026#066B6AFF\u0026#FFFFFFFF\u0026#066B6AFF\u0026#FFFFFFFF\u0026#066B6AFF\u0026#FFFFFFFF\u0026#066B6AFF \u00263\"; str(round(div(tdmg(10); 1000000); 1)); \"m \u0026b★\"); if_str(mte(tdmg(10); 1000); concat(\"\u0026#066B6AFF⁤\u0026#066B6AFF\u0026#FFFFFFFF\u0026#066B6AFF\u0026#FFFFFFFF\u0026#066B6AFF\u0026#FFFFFFFF\u0026#066B6AFF \u00263\"; str(round(div(tdmg(10); 1000); 1)); \"k \u0026b★\"); concat(\"\u0026#066B6AFF⁤\u0026#066B6AFF\u0026#FFFFFFFF\u0026#066B6AFF\u0026#FFFFFFFF\u0026#066B6AFF\u0026#FFFFFFFF\u0026#066B6AFF \u00263\"; str(int(tdmg(10))); \" \u0026b★\")))); \"\"))}",
