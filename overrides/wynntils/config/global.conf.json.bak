  "infoBoxFeature.infoBoxOverlay5.customName": "Lootrun",
  "infoBoxFeature.infoBoxOverlay5.content": "{if_str(string_equals(lootrun_state; \"NOT_RUNNING\"); \"\"; concat(\r\n\r\n  \"\u0026e\";\r\n  if_str(string_equals(lootrun_last_selected_beacon_color; \"Yellow\");\r\n    if_str(lootrun_last_selected_beacon_vibrant; \"\u0026n\u0026l\"; \"\u0026n\");\r\n    \"\"\r\n  );\r\n  string(lootrun_beacon_count(\"YELLOW\"));\r\n  \"\u0026r\";\r\n  if_str(lt(lootrun_beacon_count(\"YELLOW\"); 10); \"  \"; \" \");\r\n\r\n  \" \u00269\";\r\n  if_str(string_equals(lootrun_last_selected_beacon_color; \"Blue\");\r\n    if_str(lootrun_last_selected_beacon_vibrant; \"\u0026n\u0026l\"; \"\u0026n\");\r\n    \"\"\r\n  );\r\n  string(lootrun_beacon_count(\"BLUE\"));\r\n  \"\u0026r\";\r\n  if_str(lt(lootrun_beacon_count(\"BLUE\"); 10); \"  \"; \" \");\r\n\r\n  \" \u00265\";\r\n  if_str(string_equals(lootrun_last_selected_beacon_color; \"Purple\");\r\n    if_str(lootrun_last_selected_beacon_vibrant; \"\u0026n\u0026l\"; \"\u0026n\");\r\n    \"\"\r\n  );\r\n  string(lootrun_beacon_count(\"PURPLE\"));\r\n  \"\u0026r\";\r\n  if_str(lt(lootrun_beacon_count(\"PURPLE\"); 10); \"  \"; \" \");\r\n\r\n  \" \u0026b\";\r\n  if_str(string_equals(lootrun_last_selected_beacon_color; \"Aqua\");\r\n    if_str(lootrun_last_selected_beacon_vibrant; \"\u0026n\u0026l\"; \"\u0026n\");\r\n    \"\"\r\n  );\r\n  string(lootrun_beacon_count(\"AQUA\"));\r\n  \"\u0026r\";\r\n\r\n  \"\\n\u0026a\";\r\n  if_str(string_equals(lootrun_last_selected_beacon_color; \"Green\");\r\n    if_str(lootrun_last_selected_beacon_vibrant; \"\u0026n\u0026l\"; \"\u0026n\");\r\n    \"\"\r\n  );\r\n  string(lootrun_beacon_count(\"GREEN\"));\r\n  \"\u0026r\";\r\n  if_str(lt(lootrun_beacon_count(\"GREEN\"); 10); \"  \"; \" \");\r\n\r\n  \" \u0026c\";\r\n  if_str(string_equals(lootrun_last_selected_beacon_color; \"Red\");\r\n    if_str(lootrun_last_selected_beacon_vibrant; \"\u0026n\u0026l\"; \"\u0026n\");\r\n    \"\"\r\n  );\r\n  if_str(gte(cap(lootrun_challenges); 100);\r\n    \"\u0026m\";\r\n    \"\"\r\n  );\r\n  string(lootrun_beacon_count(\"RED\"));\r\n  \"\u0026r\";\r\n  if_str(lt(lootrun_beacon_count(\"RED\"); 10); \"  \"; \" \");\r\n\r\n  \" \u00266\";\r\n  if_str(string_equals(lootrun_last_selected_beacon_color; \"Orange\");\r\n    if_str(lootrun_last_selected_beacon_vibrant; \"\u0026n\u0026l\"; \"\u0026n\");\r\n    \"\"\r\n  );\r\n  if_str(\r\n    gte(\r\n      add(3; lootrun_orange_beacon_count);\r\n      6\r\n    );\r\n    \"\u0026m\";\r\n    \"\"\r\n  );\r\n  string(lootrun_beacon_count(\"ORANGE\"));\r\n  \"\u0026r\";\r\n  if_str(lt(lootrun_beacon_count(\"ORANGE\"); 10); \"  \"; \" \");\r\n\r\n  \" \u0026d\";\r\n  if_str(string_equals(lootrun_last_selected_beacon_color; \"Pink\");\r\n    if_str(lootrun_last_selected_beacon_vibrant; \"\u0026n\u0026l\"; \"\u0026n\");\r\n    \"\"\r\n  );\r\n  string(lootrun_beacon_count(\"PINK\"));\r\n  \"\u0026r\";\r\n\r\n  \"\\n\u00268\";\r\n  if_str(string_equals(lootrun_last_selected_beacon_color; \"Dark Gray\");\r\n    if_str(lootrun_last_selected_beacon_vibrant; \"\u0026n\u0026l\"; \"\u0026n\");\r\n    \"\"\r\n  );\r\n  if_str(\r\n    or(\r\n      eq_str(lootrun_trial(0); \"Monochromokopia\");\r\n      eq_str(lootrun_trial(1); \"Monochromokopia\")\r\n    );\r\n    if_str(eq(lootrun_beacon_count(\"DARK_GRAY\"); 2);\r\n      \"MAX\";\r\n      concat(string(lootrun_beacon_count(\"DARK_GRAY\")); \"/2\")\r\n    );\r\n    if_str(eq(lootrun_beacon_count(\"DARK_GRAY\"); 1);\r\n      \"MAX\";\r\n      concat(string(lootrun_beacon_count(\"DARK_GRAY\")); \"/1\")\r\n    )\r\n  );\r\n  \"\u0026r\";\r\n\r\n  \" \u0026f\";\r\n  if_str(string_equals(lootrun_last_selected_beacon_color; \"White\");\r\n    if_str(lootrun_last_selected_beacon_vibrant; \"\u0026n\u0026l\"; \"\u0026n\");\r\n    \"\"\r\n  );\r\n  if_str(\r\n    or(\r\n      eq_str(lootrun_trial(0); \"Monochromokopia\");\r\n      eq_str(lootrun_trial(1); \"Monochromokopia\")\r\n    );\r\n    if_str(eq(lootrun_beacon_count(\"WHITE\"); 2);\r\n      \"MAX\";\r\n      concat(string(lootrun_beacon_count(\"WHITE\")); \"/2\")\r\n    );\r\n    if_str(eq(lootrun_beacon_count(\"WHITE\"); 1);\r\n      \"MAX\";\r\n      concat(string(lootrun_beacon_count(\"WHITE\")); \"/1\")\r\n    )\r\n  );\r\n  \"\u0026r\";\r\n\r\n  \"\\n\u00267\";\r\n  if_str(string_equals(lootrun_last_selected_beacon_color; \"Gray\");\r\n    if_str(lootrun_last_selected_beacon_vibrant; \"\u0026n\u0026l\"; \"\u0026n\");\r\n    \"\"\r\n  );\r\n  if_str(\r\n    or(\r\n      gt(current(lootrun_challenges); 70);\r\n      eq_str(lootrun_mission(0; false); \"Unknown\")\r\n    );\r\n    \"\u0026m\";\r\n    \"\"\r\n  );\r\n  if_str(\r\n    or(\r\n      eq_str(lootrun_trial(0); \"Monochromokopia\");\r\n      eq_str(lootrun_trial(1); \"Monochromokopia\")\r\n    );\r\n    if_str(eq(lootrun_beacon_count(\"GRAY\"); 4);\r\n      \"MAX\";\r\n      concat(string(lootrun_beacon_count(\"GRAY\")); \"/4\")\r\n    );\r\n    if_str(eq(lootrun_beacon_count(\"GRAY\"); 3);\r\n      \"MAX\";\r\n      concat(string(lootrun_beacon_count(\"GRAY\")); \"/3\")\r\n    )\r\n  );\r\n  \"\u0026r\";\r\n\r\n  \" \u0026#00f010ff\";\r\n  if_str(string_equals(lootrun_last_selected_beacon_color; \"Crimson\");\r\n    if_str(lootrun_last_selected_beacon_vibrant; \"\u0026n\u0026l\"; \"\u0026n\");\r\n    \"\"\r\n  );\r\n  if_str(\r\n    or(\r\n      lt(current(lootrun_challenges); 20);\r\n      gt(current(lootrun_challenges); 70)\r\n    );\r\n    \"\u0026m\";\r\n    \"\"\r\n  );\r\n  if_str(eq(lootrun_beacon_count(\"CRIMSON\"); 2);\r\n    \"MAX\";\r\n    concat(string(lootrun_beacon_count(\"CRIMSON\")); \"/2\")\r\n  );\r\n  \"\u0026r\";\r\n\r\n  \"\\n\u0026#00f000ff\";\r\n  if_str(\r\n    lte(current(lootrun_challenges); 10);\r\n    \"\u0026m\";\r\n    \"\"\r\n  );\r\n  if_str(gt(lootrun_beacon_count(\"RAINBOW\"); 0);\r\n    if_str(gt(lootrun_beacon_count(\"RAINBOW\"); 1);\r\n      concat(\r\n        if_str(string_equals(lootrun_last_selected_beacon_color; \"Rainbow\");\r\n          if_str(lootrun_last_selected_bea